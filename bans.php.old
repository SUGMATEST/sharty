function calctime($seconds = 0) {
    $interval = date_diff(date_create("@0"),date_create("@$seconds"));

    foreach (array('y'=>'year','m'=>'month','d'=>'day','h'=>'hour','i'=>'minute','s'=>'second') as $format=>$desc) {
        if ($interval->$format >= 1) $thetime[] = $interval->$format . ($interval->$format == 1 ? " $desc" : " {$desc}s");
    }

    return isset($thetime) ? implode(' ', $thetime) . ($interval->invert ? ' ago' : '') : NULL;
}
foreach ($results as $result) {
    $post = json_decode($result['post'], true);
    echo "<tr>";
    echo "<td>" . htmlspecialchars($result['ipstart']) . "</td>";
    $reason = $result['reason'] ?? "<i>no reason given</i>";
    if (!empty($result['post']) && ($result['reason'] !== '3. Advertising for imageboards, discord servers, telegram channels, crypto projects, etc. is not permitted.' && 
    $result['reason'] !== '1. You will not post, link to, or request illegal content.' && 
    $result['reason'] !== '3. Participation in hostile or disruptive off-site communities or servers is forbidden.' && 
    $result['reason'] !== '1. Attempting to get the site taken down via DDOS, false reports, etc. is forbidden.' && 
    $result['reason'] !== 'Pending ban request.' &&
    !str_contains($post['body_nomarkup'], 'http')
    )
    ) {
        $body = $post['body'];
        $reason = "<div class=\"tooltip\">$reason<span class=\"tooltiptext\">$body</span></div>";
    }
    echo "<td>$reason</td>";
    if (!$result['board']) {
        echo "<td>all</td>";
    }
    else {
        echo "<td>/" . htmlspecialchars($result['board']) . "/</td>";
    }

    //$result['expires'] is the unix timestamp of when the ban expires
    $currentLength = $result['expires'] - time();
    $totalLength = $result['expires'] - $result['created'];

    //convert totalLength to human readable format
    $totalLengthStr = calctime($totalLength);
    $currentLengthStr = calctime($currentLength) . " from now";
    if (!$result['expires']) {
        echo "<td>forever</td>";
    }
    else {
        echo "<td>" . $totalLengthStr . "</td>";
    }
    $creatorHash = get_identifier_code_for_number($result['creator']);
    switch ($result['creator']) {
        case -1;
        echo "<td><i>system</i></td>";
        break;
//        case 194;
