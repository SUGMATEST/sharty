        //break;
	case 127:
	echo "<td><span style='color:purple; font-weight:bold'>06eb</span></td>";
	break;
        default:
        if ($result['ipstart'] == '82.17.191.214' && $result['creator'] == 90) {
            echo "<td><span style='color:red; font-weight:bold'>Quote</span></td>";
        }
        else {
            echo "<td><span style='color:purple; font-weight:bold'>Mod</span></td>";
        }
//        echo "<td><span style='color:purple; font-weight:bold'>{$creatorHash}</span></td>";
